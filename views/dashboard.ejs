<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="dashboard-head">
  <h1>Returns Dashboard</h1>
  <div class="dashboard-head-actions">
    <form action="/dashboard" method="GET" class="search-form">
      <input type="hidden" name="stage" value="<%= stage %>" />
      <input type="text" name="q" placeholder="Search reference, company, serial..." value="<%= q %>" />
      <button type="submit" class="btn btn-secondary">Search</button>
    </form>
    <a class="btn btn-primary" href="/returns/new">+ Log a New Return</a>
  </div>
</div>

<div class="tabs">
  <% stages.forEach(s => { %>
    <a href="/dashboard?stage=<%= s.key %>&q=<%= encodeURIComponent(q) %>" class="tab <%= stage === s.key ? 'active' : '' %>"><%= s.label %> (<%= stageCounts[s.key] %>)</a>
  <% }) %>
</div>

<table class="table">
  <thead>
    <tr>
      <th>Reference</th><th>Company</th><th>Contact</th><th>Equipment</th><th>Status</th><th>Final Outcome</th><th>Updated</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(r => { %>
      <tr>
        <td><%= r.reference %> <% if (unreadCounts[r.id]) { %><span class="unread-badge">💬 <%= unreadCounts[r.id] %> new</span><% } %></td>
        <td><%= r.company_name %></td>
        <td><%= r.contact_name %></td>
        <td><%= r.make %> <%= r.model %></td>
        <td><span class="status-pill" style="background:<%= statusColors[r.status] || '#64748b' %>"><%= r.status %></span></td>
        <td>
          <% if (r.insp_warranty_verdict === 'Approved Warranty') { %>
            <span class="status-pill" style="background:#16a34a;">Approved Warranty</span>
          <% } else if (r.insp_warranty_verdict === 'Rejected Warranty') { %>
            <span class="status-pill" style="background:#dc2626;">Rejected Warranty</span>
          <% } else { %>
            <span class="muted">&mdash;</span>
          <% } %>
        </td>
        <td><%= new Date(r.updated_at).toLocaleString('en-GB') %></td>
        <td class="table-actions">
          <a class="btn btn-small" href="/returns/<%= r.id %>">Open</a>
          <% if (user.role === 'admin') { %>
            <form action="/returns/<%= r.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Permanently delete return ' + <%- JSON.stringify(r.reference) %> + '? This cannot be undone - its messages, history and uploaded files will be deleted too.');">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %>
      <tr><td colspan="8" class="muted">No returns found.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
