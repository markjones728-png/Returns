<%- include('partials/header', { title: r.reference + ' - ' + r.status }) %>

<div class="detail-head">
  <h1><%= r.reference %></h1>
  <span class="status-pill big" style="background:<%= statusColors[r.status] || '#64748b' %>"><%= r.status %></span>
  <a class="btn btn-secondary" href="/returns/<%= r.id %>/pdf">Download PDF Report</a>
  <a class="btn btn-secondary" href="/returns/<%= r.id %>/rt-form.pdf">Download Roger Technology RMA Form</a>
  <form action="/returns/<%= r.id %>/send-report" method="POST" class="inline-form">
    <button type="submit" class="btn btn-secondary">Email Report to Customer</button>
  </form>
  <% if (r.status !== closedStatus) { %>
    <form action="/returns/<%= r.id %>/archive" method="POST" class="inline-form">
      <button type="submit" class="btn btn-secondary">Archive This Return</button>
    </form>
  <% } %>
</div>

<div class="grid-2">
  <div class="card">
    <h2>Customer Details</h2>
    <p><strong>Company:</strong> <%= r.company_name %></p>
    <p><strong>Contact:</strong> <%= r.contact_name %></p>
    <p><strong>Phone:</strong> <%= r.phone %></p>
    <p><strong>Email:</strong> <%= r.email %></p>
  </div>

  <div class="card">
    <h2>Equipment Details</h2>
    <p><strong>Type:</strong> <%= r.equipment_type %></p>
    <p><strong>Make:</strong> <%= r.make %></p>
    <p><strong>Model:</strong> <%= r.model %></p>
    <p><strong>Serial Number:</strong> <%= r.serial_number %></p>
    <% if (r.manufacturer_rma_number) { %>
      <p><strong>Manufacturer RMA Number:</strong> <%= r.manufacturer_rma_number %></p>
    <% } %>
    <% if (r.rta_rt_number) { %>
      <p><strong>RTA RT Number:</strong> <%= r.rta_rt_number %></p>
    <% } %>
  </div>
</div>

<div class="card">
  <h2>Collection Details</h2>
  <p><strong>Address:</strong> <%= r.collection_address %></p>
  <p><strong>Premises Type:</strong> <%= r.premises_type %></p>
  <p><strong>Open Hours:</strong> <%= r.collection_hours %></p>
  <p><strong>Courier Contact Number:</strong> <%= r.courier_contact_number %></p>
</div>

<div class="card">
  <h2>Fault Description</h2>
  <p><%= r.fault_description %></p>
</div>

<% if (r.insp_application_type || r.insp_product_type || r.insp_dimensions || r.insp_weight || r.insp_install_date) { %>
<div class="card">
  <h2>Installation Details</h2>
  <p class="muted">Captured when the return was booked in (editable below in the Inspection Form).</p>
  <p><strong>Application Type:</strong> <%= r.insp_application_type || '-' %></p>
  <p><strong>Door / Product Type:</strong> <%= r.insp_product_type || '-' %></p>
  <p><strong>Dimensions:</strong> <%= r.insp_dimensions || '-' %></p>
  <p><strong>Weight:</strong> <%= r.insp_weight || '-' %></p>
  <p><strong>Installation Date:</strong> <%= r.insp_install_date || '-' %></p>
</div>
<% } %>


<div class="card" id="inspection">
  <h2>Roger Technology Inspection Form</h2>
  <p class="muted">
    Fill this in when the unit is received and inspected. It captures the same information as
    Roger Technology's own "Request for Authorisation to Return Product for Inspection" form, so a
    filled copy of their form can be generated straight from here and emailed to
    service@rogertechnology.it.
  </p>
  <p class="muted">
    <strong>Dealer Details (fixed):</strong> <%= DEALER_DETAILS.tradingName %>, <%= DEALER_DETAILS.operator %>,
    <%= DEALER_DETAILS.telephone %>, <%= DEALER_DETAILS.email %>
  </p>
  <form action="/returns/<%= r.id %>/inspection" method="POST" class="form-grid">
    <h2 class="full section-heading">Installation Details</h2>
    <label>Application Type
      <select name="insp_application_type">
        <option value="">-- Select --</option>
        <% APPLICATION_TYPES.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_application_type === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label>Door / Product Type
      <select name="insp_product_type">
        <option value="">-- Select --</option>
        <% PRODUCT_TYPES.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_product_type === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label>Dimensions
      <input type="text" name="insp_dimensions" value="<%= r.insp_dimensions %>" placeholder="e.g. 4m x 2m" />
    </label>
    <label>Weight
      <input type="text" name="insp_weight" value="<%= r.insp_weight %>" placeholder="e.g. 120kg" />
    </label>
    <label>Installation Date
      <input type="date" name="insp_install_date" value="<%= r.insp_install_date %>" />
    </label>

    <h2 class="full section-heading">Product Details</h2>
    <label>Product Code
      <input type="text" name="insp_product_code" value="<%= r.insp_product_code %>" />
    </label>
    <label>Quantity
      <input type="text" name="insp_quantity" value="<%= r.insp_quantity %>" />
    </label>
  <label>Warranty Status
      <select name="insp_guarantee_status">
        <option value="">-- Select --</option>
        <% WARRANTY_STATUSES.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_guarantee_status === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>

    <h2 class="full section-heading">Nameplate Data</h2>
    <label>P.CODE
      <input type="text" name="insp_plate_p_code" value="<%= r.insp_plate_p_code %>" />
    </label>
    <label>Voltage
      <input type="text" name="insp_plate_voltage" value="<%= r.insp_plate_voltage %>" />
    </label>
    <label>Batch
      <input type="text" name="insp_plate_batch" value="<%= r.insp_plate_batch %>" />
    </label>
    <label>IN
      <input type="text" name="insp_plate_in" value="<%= r.insp_plate_in %>" />
    </label>
    <label>PM
      <input type="text" name="insp_plate_pm" value="<%= r.insp_plate_pm %>" />
    </label>

    <h2 class="full section-heading">Problem Found</h2>
    <label class="full">Problem Identified by Client
      <textarea name="insp_problem_by_client" rows="2"><%= r.insp_problem_by_client %></textarea>
    </label>
    <label class="full">Problem Identified by Dealer / Engineer
      <textarea name="insp_problem_by_dealer" rows="2"><%= r.insp_problem_by_dealer %></textarea>
    </label>
    <label class="full">Action Suggested
      <textarea name="insp_action_suggested" rows="2"><%= r.insp_action_suggested %></textarea>
    </label>
    <label>Repairable?
      <select name="insp_repairable">
        <option value="">-- Select --</option>
        <% REPAIRABLE_OPTIONS.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_repairable === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label>Request Type
      <select name="insp_request_type">
        <option value="">-- Select --</option>
        <% REQUEST_TYPES.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_request_type === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>

    <button type="submit" class="btn btn-primary full">Save Inspection Details</button>
  </form>
  <% if (r.insp_completed_by) { %>
    <p class="muted">Last saved by <%= r.insp_completed_by %> on <%= new Date(r.insp_completed_at).toLocaleString('en-GB') %></p>
  <% } %>
</div>

<div class="card" id="testing">
  <h2>Testing</h2>
  <p class="muted">Fill this in once the unit has been tested on the bench.</p>
  <form action="/returns/<%= r.id %>/test" method="POST" class="form-grid">
    <label>Test Result
      <select name="test_result">
        <option value="">-- Select --</option>
        <% TEST_RESULTS.forEach(o => { %>
          <option value="<%= o %>" <%= r.test_result === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label class="full">Test Notes
      <textarea name="test_notes" rows="3"><%= r.test_notes %></textarea>
    </label>
    <button type="submit" class="btn btn-primary full">Save Test Results</button>
  </form>
  <% if (r.test_completed_by) { %>
    <p class="muted">Last saved by <%= r.test_completed_by %> on <%= new Date(r.test_completed_at).toLocaleString('en-GB') %></p>
  <% } %>
</div>

<div class="card">
  <h2>Update Status</h2>
  <form action="/returns/<%= r.id %>/status" method="POST" class="form-grid">
    <label>New Status
      <select name="status" id="statusSelect" required>
        <% STATUSES.forEach(s => { %>
          <option value="<%= s %>" <%= s === r.status ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </label>
    <label class="full" id="rmaNumberField" style="display:none;">Manufacturer RMA Number
      <input type="text" name="manufacturer_rma_number" id="rmaNumberInput" value="<%= r.manufacturer_rma_number %>" placeholder="e.g. RMA-12345" />
    </label>
    <label class="full" id="rtaNumberField" style="display:none;">RTA RT Number
      <input type="text" name="rta_rt_number" id="rtaNumberInput" value="<%= r.rta_rt_number %>" placeholder="e.g. RT-12345" />
    </label>
    <label class="full">Note (optional)
      <input type="text" name="note" placeholder="e.g. Collected by XYZ Couriers, tracking 12345" />
    </label>
    <p class="muted full">The customer will automatically be emailed whenever you change the status.</p>
    <button type="submit" class="btn btn-primary full">Update Status</button>
  </form>
</div>

<script>
  (function () {
    var rmaStatuses = <%- JSON.stringify(STATUSES_NEEDING_RMA_NUMBER) %>;
    var rtaStatuses = <%- JSON.stringify(STATUSES_NEEDING_RTA_NUMBER) %>;
    var select = document.getElementById('statusSelect');
    var rmaField = document.getElementById('rmaNumberField');
    var rtaField = document.getElementById('rtaNumberField');
    function updateFields() {
      rmaField.style.display = rmaStatuses.indexOf(select.value) !== -1 ? '' : 'none';
      rtaField.style.display = rtaStatuses.indexOf(select.value) !== -1 ? '' : 'none';
    }
    select.addEventListener('change', updateFields);
    updateFields();
  })();
</script>

<div class="card">
  <h2>Staff Notes</h2>
  <form action="/returns/<%= r.id %>/notes" method="POST" class="form-grid">
    <textarea name="staff_notes" rows="4" class="full"><%= r.staff_notes %></textarea>
    <button type="submit" class="btn btn-secondary full">Save Notes</button>
  </form>
</div>

<div class="card">
  <h2>Photos &amp; Videos</h2>
  <div class="media-grid">
    <% files.forEach(f => { %>
      <div class="media-item">
        <% if (f.kind === 'photo') { %>
          <a href="/files/<%= r.id %>/<%= f.filename %>" target="_blank">
            <img src="/files/<%= r.id %>/<%= f.filename %>" alt="<%= f.original_name %>" />
          </a>
        <% } else { %>
          <video controls src="/files/<%= r.id %>/<%= f.filename %>"></video>
        <% } %>
        <div class="media-caption"><%= f.original_name %> <span class="muted">(<%= f.uploaded_by %>)</span></div>
      </div>
    <% }) %>
    <% if (files.length === 0) { %><p class="muted">No files uploaded yet.</p><% } %>
  </div>
  <form action="/returns/<%= r.id %>/files" method="POST" enctype="multipart/form-data" class="form-grid">
    <label class="full">Upload additional photos/videos
      <input type="file" name="files" multiple accept="image/*,video/*" />
    </label>
    <button type="submit" class="btn btn-secondary full">Upload</button>
  </form>
</div>

<div class="card">
  <h2>Status History</h2>
  <ul class="timeline">
    <% history.forEach(h => { %>
      <li><strong><%= h.status %></strong> &mdash; <%= new Date(h.changed_at).toLocaleString('en-GB') %> by <%= h.changed_by %><% if (h.note) { %> <em>(<%= h.note %>)</em><% } %></li>
    <% }) %>
  </ul>
</div>

<%- include('partials/footer') %>
