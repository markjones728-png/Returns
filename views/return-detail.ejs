<%- include('partials/header', { title: r.reference + ' - ' + r.status }) %>

<div class="detail-head">
  <h1><%= r.reference %></h1>
  <span class="status-pill big" style="background:<%= statusColors[r.status] || '#64748b' %>"><%= r.status %></span>
  <a class="btn btn-secondary" href="/returns/<%= r.id %>/pdf">Download PDF Report</a>
  <form action="/returns/<%= r.id %>/send-report" method="POST" class="inline-form">
    <button type="submit" class="btn btn-secondary">Email Report to Customer</button>
  </form>
  <% if (r.status !== closedStatus) { %>
    <form action="/returns/<%= r.id %>/archive" method="POST" class="inline-form">
      <button type="submit" class="btn btn-secondary">Archive This Return</button>
    </form>
  <% } %>
</div>

<% if (user.role === 'admin') { %>
<details class="card">
  <summary><h2 style="display:inline;">Edit Submitted Details (Admin Only)</h2></summary>
  <p class="muted">
    Corrects the details the customer originally typed in when they booked this return in (or that
    staff entered on their behalf). Changing the email address also changes what the customer needs
    to use on the Track a Return page and where their emails are sent.
  </p>
  <form action="/returns/<%= r.id %>/customer-details" method="POST" class="form-grid">
    <h2 class="full section-heading">Your Details</h2>
    <label>Company Name *
      <input type="text" name="company_name" value="<%= r.company_name %>" required />
    </label>
    <label>Contact Name *
      <input type="text" name="contact_name" value="<%= r.contact_name %>" required />
    </label>
    <label>Phone Number *
      <input type="tel" name="phone" value="<%= r.phone %>" required />
    </label>
    <label>Email Address *
      <input type="email" name="email" value="<%= r.email %>" required />
    </label>

    <h2 class="full section-heading">Collection Details</h2>
    <label class="full">Collection Address *
      <textarea name="collection_address" rows="3" required><%= r.collection_address %></textarea>
    </label>
    <label>Premises Type *
      <select name="premises_type" required>
        <% ['Office', 'House', 'Unit', 'Box', 'Shed', 'Other'].forEach(t => { %>
          <option value="<%= t %>" <%= r.premises_type === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <label>Open Hours of Collection Address *
      <input type="text" name="collection_hours" value="<%= r.collection_hours %>" required />
    </label>
    <label class="full">Contact Number for Courier *
      <input type="tel" name="courier_contact_number" value="<%= r.courier_contact_number %>" required />
    </label>

    <h2 class="full section-heading">Equipment Details</h2>
    <label>Equipment Type *
      <input type="text" name="equipment_type" value="<%= r.equipment_type %>" required />
    </label>
    <label>Make *
      <input type="text" name="make" value="<%= r.make %>" required />
    </label>
    <label>Model *
      <input type="text" name="model" value="<%= r.model %>" required />
    </label>
    <label>Serial Number *
      <input type="text" name="serial_number" value="<%= r.serial_number %>" required />
    </label>
    <label class="full">Description of Fault *
      <textarea name="fault_description" rows="4" required><%= r.fault_description %></textarea>
    </label>

    <h2 class="full section-heading">Installation Details (if known)</h2>
    <label>Application Type
      <select name="insp_application_type">
        <option value="">-- Select --</option>
        <% APPLICATION_TYPES.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_application_type === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label>Door / Product Type
      <select name="insp_product_type">
        <option value="">-- Select --</option>
        <% PRODUCT_TYPES.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_product_type === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label>Dimensions
      <input type="text" name="insp_dimensions" value="<%= r.insp_dimensions %>" />
    </label>
    <label>Weight
      <input type="text" name="insp_weight" value="<%= r.insp_weight %>" />
    </label>
    <label>Installation Date
      <input type="date" name="insp_install_date" value="<%= r.insp_install_date %>" />
    </label>

    <button type="submit" class="btn btn-primary full">Save Corrected Details</button>
  </form>
</details>
<% } %>

<div class="grid-2">
  <div class="card">
    <h2>Customer Details</h2>
    <p><strong>Company:</strong> <%= r.company_name %></p>
    <p><strong>Contact:</strong> <%= r.contact_name %></p>
    <p><strong>Phone:</strong> <%= r.phone %></p>
    <p><strong>Email:</strong> <%= r.email %></p>
  </div>

  <div class="card">
    <h2>Equipment Details</h2>
    <p><strong>Type:</strong> <%= r.equipment_type %></p>
    <p><strong>Make:</strong> <%= r.make %></p>
    <p><strong>Model:</strong> <%= r.model %></p>
    <p><strong>Serial Number:</strong> <%= r.serial_number %></p>
    <% if (r.manufacturer_rma_number) { %>
      <p><strong>Manufacturer RMA Number:</strong> <%= r.manufacturer_rma_number %></p>
    <% } %>
    <% if (r.rta_rt_number) { %>
      <p><strong>RTA RT Number:</strong> <%= r.rta_rt_number %></p>
    <% } %>
  </div>
</div>

<div class="card">
  <h2>Collection Details</h2>
  <p><strong>Address:</strong> <%= r.collection_address %></p>
  <p><strong>Premises Type:</strong> <%= r.premises_type %></p>
  <p><strong>Open Hours:</strong> <%= r.collection_hours %></p>
  <p><strong>Courier Contact Number:</strong> <%= r.courier_contact_number %></p>
</div>

<div class="card">
  <h2>Fault Description</h2>
  <p><%= r.fault_description %></p>
</div>

<% if (r.insp_application_type || r.insp_product_type || r.insp_dimensions || r.insp_weight || r.insp_install_date) { %>
<div class="card">
  <h2>Installation Details</h2>
  <p class="muted">Captured when the return was booked in (editable below in the Inspection Form).</p>
  <p><strong>Application Type:</strong> <%= r.insp_application_type || '-' %></p>
  <p><strong>Door / Product Type:</strong> <%= r.insp_product_type || '-' %></p>
  <p><strong>Dimensions:</strong> <%= r.insp_dimensions || '-' %></p>
  <p><strong>Weight:</strong> <%= r.insp_weight || '-' %></p>
  <p><strong>Installation Date:</strong> <%= r.insp_install_date || '-' %></p>
</div>
<% } %>

<div class="card" id="received">
  <h2>Item Received Condition</h2>
  <p class="muted">
    Record the condition of the item as received, before inspection. This information is for
    internal/staff use only - it is never included in anything emailed to the customer.
  </p>
  <div class="media-grid">
    <% files.filter(f => f.kind === 'received_photo' || f.kind === 'received_video' || f.kind === 'received_document').forEach(f => { %>
      <div class="media-item">
        <% if (f.kind === 'received_photo') { %>
          <a href="/files/<%= r.id %>/<%= f.filename %>" target="_blank">
            <img src="/files/<%= r.id %>/<%= f.filename %>" alt="<%= f.original_name %>" />
          </a>
        <% } else if (f.kind === 'received_video') { %>
          <video controls src="/files/<%= r.id %>/<%= f.filename %>"></video>
        <% } else { %>
          <a class="doc-tile" href="/files/<%= r.id %>/<%= f.filename %>" target="_blank">
            <span class="doc-icon">📄</span>
            <span class="doc-label">PDF</span>
          </a>
        <% } %>
        <div class="media-caption"><%= f.original_name %> <span class="muted">(<%= f.uploaded_by %>)</span></div>
        <form action="/returns/<%= r.id %>/files/<%= f.id %>/caption" method="POST" class="caption-form">
          <input type="hidden" name="redirect_anchor" value="received" />
          <input type="text" name="caption" value="<%= f.caption %>" placeholder="Add a note about this photo..." />
          <button type="submit" class="btn-tiny">Save</button>
        </form>
      </div>
    <% }) %>
    <% if (!files.some(f => f.kind === 'received_photo' || f.kind === 'received_video' || f.kind === 'received_document')) { %>
      <p class="muted">No received-condition photos, videos or documents uploaded yet.</p>
    <% } %>
  </div>
  <form action="/returns/<%= r.id %>/received" method="POST" enctype="multipart/form-data" class="form-grid">
    <label class="full">Upload photos, videos or PDF documents of the item as received
      <input type="file" name="files" multiple accept="image/*,video/*,application/pdf" />
    </label>
    <label class="full">Parts Status</label>
    <div class="full radio-group">
      <% RECEIVED_PARTS_STATUSES.forEach(o => { %>
        <label class="radio-option">
          <input type="radio" name="received_parts_status" value="<%= o %>" <%= r.received_parts_status === o ? 'checked' : '' %> />
          <%= o %>
        </label>
      <% }) %>
    </div>
    <label class="full">Initial Condition on Arrival (tick all that apply)</label>
    <% var currentFlags = (r.received_condition_flags || '').split(',').map(s => s.trim()).filter(Boolean); %>
    <div class="full radio-group">
      <% ARRIVAL_CONDITION_FLAGS.forEach(o => { %>
        <label class="radio-option">
          <input type="checkbox" name="received_condition_flags" value="<%= o %>" <%= currentFlags.includes(o) ? 'checked' : '' %> />
          <%= o %>
        </label>
      <% }) %>
    </div>
    <label class="full">Notes
      <textarea name="received_notes" rows="3" placeholder="e.g. list of any missing parts"><%= r.received_notes %></textarea>
    </label>
    <button type="submit" class="btn btn-primary full">Save Received Condition</button>
  </form>
  <% if (r.received_completed_by) { %>
    <p class="muted">Last saved by <%= r.received_completed_by %> on <%= new Date(r.received_completed_at).toLocaleString('en-GB') %></p>
  <% } %>
</div>

<div class="card" id="inspection">
  <h2>Roger Technology Warranty Repair Return Form</h2>
  <p class="muted">
    Matches Roger Technology's own "Warranty Repair Return Form". The customer/company details,
    product/serial number, and fault description are already captured above and don't need
    repeating here - this only covers what that form asks for that isn't captured elsewhere.
  </p>
  <form action="/returns/<%= r.id %>/inspection" method="POST" class="form-grid">
    <h2 class="full section-heading">Product Information</h2>
    <label>Original Invoice / Order Number
      <input type="text" name="insp_invoice_number" value="<%= r.insp_invoice_number %>" />
    </label>
    <label>Product Type (Roger Component)
      <select name="insp_rt_product_type">
        <option value="">-- Select --</option>
        <% RT_PRODUCT_TYPES.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_rt_product_type === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label>Age of Installation
      <select name="insp_installation_age">
        <option value="">-- Select --</option>
        <% INSTALLATION_AGE_OPTIONS.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_installation_age === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>

    <h2 class="full section-heading">Reported Fault</h2>
    <label>When Does the Fault Occur?
      <select name="insp_fault_occurrence">
        <option value="">-- Select --</option>
        <% FAULT_OCCURRENCE_OPTIONS.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_fault_occurrence === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>

    <button type="submit" class="btn btn-primary full">Save Inspection Details</button>
  </form>
  <% if (r.insp_completed_by) { %>
    <p class="muted">Last saved by <%= r.insp_completed_by %> on <%= new Date(r.insp_completed_at).toLocaleString('en-GB') %></p>
  <% } %>
</div>

<div class="card" id="testing">
  <h2>Testing</h2>
  <p class="muted">Fill this in once the unit has been tested on the bench.</p>
  <form action="/returns/<%= r.id %>/test" method="POST" class="form-grid">
    <label>Test Result
      <select name="test_result">
        <option value="">-- Select --</option>
        <% TEST_RESULTS.forEach(o => { %>
          <option value="<%= o %>" <%= r.test_result === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label class="full">Test Notes
      <textarea name="test_notes" rows="3"><%= r.test_notes %></textarea>
    </label>
    <button type="submit" class="btn btn-primary full">Save Test Results</button>
  </form>
  <% if (r.test_completed_by) { %>
    <p class="muted">Last saved by <%= r.test_completed_by %> on <%= new Date(r.test_completed_at).toLocaleString('en-GB') %></p>
  <% } %>
</div>

<div class="card" id="warranty">
  <h2>Warranty Determination &amp; Final Verdict</h2>
  <p class="muted">
    Internal/staff use only - fill this in once testing is complete to record the final warranty
    decision. This is never included on anything emailed or shown to the customer.
  </p>
  <form action="/returns/<%= r.id %>/warranty" method="POST" class="form-grid">
    <label>Final Status
      <select name="insp_warranty_verdict" id="warrantyVerdictSelect">
        <option value="">-- Select --</option>
        <% WARRANTY_VERDICT_OPTIONS.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_warranty_verdict === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label class="full" id="rejectionReasonField" style="display:none;">Reason for Rejection (if applicable)
      <select name="insp_rejection_reason">
        <option value="">-- Select --</option>
        <% REJECTION_REASONS.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_rejection_reason === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label>Action Taken
      <select name="insp_action_taken">
        <option value="">-- Select --</option>
        <% ACTION_TAKEN_OPTIONS.forEach(o => { %>
          <option value="<%= o %>" <%= r.insp_action_taken === o ? 'selected' : '' %>><%= o %></option>
        <% }) %>
      </select>
    </label>
    <label class="full">Technician's Detailed Summary
      <textarea name="insp_warranty_summary" rows="3"><%= r.insp_warranty_summary %></textarea>
    </label>
    <button type="submit" class="btn btn-primary full">Save Warranty Determination</button>
  </form>
  <% if (r.warranty_completed_by) { %>
    <p class="muted">Last saved by <%= r.warranty_completed_by %> on <%= new Date(r.warranty_completed_at).toLocaleString('en-GB') %></p>
  <% } %>
</div>

<script>
  (function () {
    var verdictSelect = document.getElementById('warrantyVerdictSelect');
    var reasonField = document.getElementById('rejectionReasonField');
    function updateReasonField() {
      reasonField.style.display = verdictSelect.value === 'Rejected Warranty' ? '' : 'none';
    }
    verdictSelect.addEventListener('change', updateReasonField);
    updateReasonField();
  })();
</script>

<div class="card">
  <h2>Update Status</h2>
  <form action="/returns/<%= r.id %>/status" method="POST" class="form-grid">
    <label>New Status
      <select name="status" id="statusSelect" required>
        <% STATUSES.forEach(s => { %>
          <option value="<%= s %>" <%= s === r.status ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </label>
    <label class="full" id="rmaNumberField" style="display:none;">Manufacturer RMA Number
      <input type="text" name="manufacturer_rma_number" id="rmaNumberInput" value="<%= r.manufacturer_rma_number %>" placeholder="e.g. RMA-12345" />
    </label>
    <label class="full" id="rtaNumberField" style="display:none;">RTA RT Number
      <input type="text" name="rta_rt_number" id="rtaNumberInput" value="<%= r.rta_rt_number %>" placeholder="e.g. RT-12345" />
    </label>
    <label class="full">Note (optional)
      <input type="text" name="note" placeholder="e.g. Collected by XYZ Couriers, tracking 12345" />
    </label>
    <p class="muted full">The customer will automatically be emailed whenever you change the status.</p>
    <button type="submit" class="btn btn-primary full">Update Status</button>
  </form>
</div>

<script>
  (function () {
    var rmaStatuses = <%- JSON.stringify(STATUSES_NEEDING_RMA_NUMBER) %>;
    var rtaStatuses = <%- JSON.stringify(STATUSES_NEEDING_RTA_NUMBER) %>;
    var select = document.getElementById('statusSelect');
    var rmaField = document.getElementById('rmaNumberField');
    var rtaField = document.getElementById('rtaNumberField');
    function updateFields() {
      rmaField.style.display = rmaStatuses.indexOf(select.value) !== -1 ? '' : 'none';
      rtaField.style.display = rtaStatuses.indexOf(select.value) !== -1 ? '' : 'none';
    }
    select.addEventListener('change', updateFields);
    updateFields();
  })();
</script>

<div class="card">
  <h2>Staff Notes</h2>
  <form action="/returns/<%= r.id %>/notes" method="POST" class="form-grid">
    <textarea name="staff_notes" rows="4" class="full"><%= r.staff_notes %></textarea>
    <button type="submit" class="btn btn-secondary full">Save Notes</button>
  </form>
</div>

<div class="card" id="photos">
  <h2>Photos, Videos &amp; Documents</h2>
  <div class="media-grid">
    <% var generalFiles = files.filter(f => f.kind === 'photo' || f.kind === 'video' || f.kind === 'document'); %>
    <% generalFiles.forEach(f => { %>
      <div class="media-item">
        <% if (f.kind === 'photo') { %>
          <a href="/files/<%= r.id %>/<%= f.filename %>" target="_blank">
            <img src="/files/<%= r.id %>/<%= f.filename %>" alt="<%= f.original_name %>" />
          </a>
        <% } else if (f.kind === 'video') { %>
          <video controls src="/files/<%= r.id %>/<%= f.filename %>"></video>
        <% } else { %>
          <a class="doc-tile" href="/files/<%= r.id %>/<%= f.filename %>" target="_blank">
            <span class="doc-icon">📄</span>
            <span class="doc-label">PDF</span>
          </a>
        <% } %>
        <div class="media-caption"><%= f.original_name %> <span class="muted">(<%= f.uploaded_by %>)</span></div>
        <form action="/returns/<%= r.id %>/files/<%= f.id %>/caption" method="POST" class="caption-form">
          <input type="hidden" name="redirect_anchor" value="photos" />
          <input type="text" name="caption" value="<%= f.caption %>" placeholder="Add a note about this photo..." />
          <button type="submit" class="btn-tiny">Save</button>
        </form>
      </div>
    <% }) %>
    <% if (generalFiles.length === 0) { %><p class="muted">No files uploaded yet.</p><% } %>
  </div>
  <form action="/returns/<%= r.id %>/files" method="POST" enctype="multipart/form-data" class="form-grid">
    <label class="full">Upload additional photos, videos or PDF documents
      <input type="file" name="files" multiple accept="image/*,video/*,application/pdf" />
    </label>
    <button type="submit" class="btn btn-secondary full">Upload</button>
  </form>
</div>

<div class="card">
  <h2>Status History</h2>
  <ul class="timeline">
    <% history.forEach(h => { %>
      <li><strong><%= h.status %></strong> &mdash; <%= new Date(h.changed_at).toLocaleString('en-GB') %> by <%= h.changed_by %><% if (h.note) { %> <em>(<%= h.note %>)</em><% } %></li>
    <% }) %>
  </ul>
</div>

<%- include('partials/footer') %>
