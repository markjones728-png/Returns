<%- include('partials/header', { title: 'Track a Return' }) %>

<h1>Track a Return</h1>
<p class="muted">Enter your reference number and the email address used when submitting the return.</p>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form action="/track" method="POST" class="card form-grid">
  <label>Reference Number *
    <input type="text" name="reference" placeholder="RT-2026-0001" value="<%= prefill ? prefill.reference : '' %>" required />
  </label>
  <label>Email Address *
    <input type="email" name="email" value="<%= prefill ? prefill.email : '' %>" required />
  </label>
  <button type="submit" class="btn btn-primary full">Track Return</button>
</form>

<% if (result) { %>
  <% const pdfQs = `reference=${encodeURIComponent(result.returnRow.reference)}&email=${encodeURIComponent(result.returnRow.email)}`; %>
  <div class="card">
    <h2><%= result.returnRow.reference %> &mdash; <span class="status-pill" style="background:#0284c7"><%= result.returnRow.status %></span></h2>
    <p><strong>Equipment:</strong> <%= result.returnRow.make %> <%= result.returnRow.model %> (Serial: <%= result.returnRow.serial_number %>)</p>
    <p><strong>Fault reported:</strong> <%= result.returnRow.fault_description %></p>
    <a class="btn btn-secondary" href="/track/pdf?<%= pdfQs %>">Download PDF Report</a>

    <h3>Photos, Videos &amp; Documents</h3>
    <div class="media-grid">
      <% result.files.forEach(f => { %>
        <div class="media-item">
          <% if (f.kind === 'photo') { %>
            <a href="/track/files/<%= f.filename %>?<%= pdfQs %>" target="_blank">
              <img src="/track/files/<%= f.filename %>?<%= pdfQs %>" alt="<%= f.original_name %>" />
            </a>
          <% } else if (f.kind === 'video') { %>
            <video controls src="/track/files/<%= f.filename %>?<%= pdfQs %>"></video>
          <% } else { %>
            <a class="doc-tile" href="/track/files/<%= f.filename %>?<%= pdfQs %>" target="_blank">
              <span class="doc-icon">📄</span>
              <span class="doc-label">PDF</span>
            </a>
          <% } %>
          <div class="media-caption"><%= f.original_name %></div>
        </div>
      <% }) %>
      <% if (result.files.length === 0) { %><p class="muted">No photos, videos or documents yet.</p><% } %>
    </div>

    <h3>Messages</h3>
    <p class="muted">Ask a question about your return, or reply to a message from our returns team.</p>
    <div class="message-thread">
      <% if (result.messages.length === 0) { %>
        <p class="muted">No messages yet.</p>
      <% } %>
      <% result.messages.forEach(m => { %>
        <div class="message-bubble message-<%= m.sender_type %>">
          <div class="message-meta">
            <strong><%= m.sender_type === 'staff' ? 'Returns Team' : m.sender_name %></strong>
            &middot; <%= new Date(m.created_at).toLocaleString('en-GB') %>
          </div>
          <div class="message-body"><%= m.body %></div>
        </div>
      <% }) %>
    </div>
    <form action="/track/message" method="POST" class="form-grid" style="margin-top:16px;">
      <input type="hidden" name="reference" value="<%= result.returnRow.reference %>" />
      <input type="hidden" name="email" value="<%= result.returnRow.email %>" />
      <label class="full">Your message
        <textarea name="body" rows="3" required placeholder="Type your message..."></textarea>
      </label>
      <button type="submit" class="btn btn-primary full">Send Message</button>
    </form>
  </div>
<% } %>

<%- include('partials/footer') %>
