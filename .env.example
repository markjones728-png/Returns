# Copy this file to .env and fill in your real values

# Port the app listens on
PORT=3000

# Session cookie secret - set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "true" once the site is served over HTTPS
COOKIE_SECURE=false

# Default admin account seeded on first run (change the password after logging in!)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Email (SMTP) settings ---
# If SMTP_HOST is left blank, emails are just printed to the console instead of sent.
# Example for Office 365 / Outlook:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=returns@yourcompany.co.uk
#   SMTP_PASS=your-password-or-app-password
# Example for Gmail (use an "App Password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
# Example for a transactional provider (SendGrid, Mailgun, Brevo, etc.) - usually easiest & most reliable
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Roger Technology Returns" <returns@yourcompany.co.uk>
